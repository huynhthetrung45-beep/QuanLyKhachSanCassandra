# Sao chep thanh backend/.env va dien gia tri. KHONG commit file .env.
PORT=3000
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=chat_ott

# Chuoi ngau nhien dai (vd. 64 ky tu hex) de ky pageToken.
# Bo trong: backend tu sinh moi lan khoi dong (token cu se bi tu choi sau restart).
PAGE_TOKEN_SECRET=

# Thoi han phien dang nhap (gio). Mac dinh 168 = 7 ngay.
SESSION_TTL_HOURS=168

# Dat true khi chay qua HTTPS.
COOKIE_SECURE=false

# Danh sach origin frontend duoc phep (cach nhau dau phay).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Thu muc luu noi dung tep dinh kem (Cassandra chi luu metadata). Bo trong = <thu muc goc>\storage\uploads
# KHONG dat trong frontend/public hay thu muc phuc vu tinh: tep chi tai qua API co kiem tra quyen.
UPLOAD_DIR=
# Gioi han tep (MB) va so tep moi tin.
MAX_UPLOAD_MB=20
MAX_FILES_PER_MESSAGE=5

# AI tom tat / trich xuat cong viec (tuy chon). Bo trong -> tinh nang AI bao "chua cau hinh", ung dung van chay.
# KHONG commit khoa that.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=30000

# ===== Chuc nang moi (giai doan PT-01..PT-26) - xem HUONG_DAN_CHUC_NANG_MOI.md =====
# Quan tri vien (PT-08, PT-16): danh sach email cach nhau dau phay, hoac dung "npm run admin:grant -- <email>".
ADMIN_EMAILS=
# Dia chi frontend dung trong link email (quen mat khau).
APP_URL=http://localhost:5173
# Gui email (PT-02, PT-09). Bo trong -> che do phat trien: in thu ra console + luu storage/outbox.
# Vi du Gmail: smtps://ten%40gmail.com:matkhauungdung@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=ChatOTT <no-reply@chatott.local>
# true: tai khoan DANG KY MOI phai nhap ma xac minh email truoc khi dung (PT-09).
REQUIRE_EMAIL_VERIFICATION=false
# Sua tin trong bao nhieu phut (PT-06).
EDIT_WINDOW_MINUTES=15
# Xem truoc lien ket (PT-21): false de tat (may chu khong tai trang ngoai).
LINK_PREVIEW=true
# Web Push (PT-14): bo trong -> tu sinh khoa va luu storage/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chatott.local
# Nhac han cong viec AI (PT-15).
TASK_REMINDERS=true
TASK_REMINDER_INTERVAL_MINUTES=15
# Giam sat (NFR-18): LOG_FORMAT=json -> log JSON (nen dat LOG_REQUESTS=false). METRICS_TOKEN bao ve GET /metrics.
LOG_FORMAT=
METRICS_TOKEN=
# Nhieu tien trinh backend (NFR-13): Redis pub/sub cho realtime.
REDIS_URL=
# Cum Cassandra (NFR-14): vd localQuorum khi chay docker-compose.cluster.yml.
CASSANDRA_CONSISTENCY=
# HTTPS (NFR-16): npm run start:https
TLS_CERT_FILE=
TLS_KEY_FILE=
HTTPS_PORT=3443
HTTP_REDIRECT_PORT=

# Tro ly AI dung Google Gemini (chatbot + goi y tra loi / dich khi chua co ANTHROPIC_API_KEY).
# Lay khoa mien phi tai https://aistudio.google.com/apikey . KHONG commit khoa that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cong viec & Lich, Nhac nho, Hop truc tuyen (xem TAI_LIEU_CONG_VIEC_LICH_HOP.md).
# Khoa ky ma tham gia phong hop. Bo trong -> sinh ngau nhien moi lan chay (nen dat khi chay nhieu tien trinh). KHONG commit gia tri that.
MEETING_TOKEN_SECRET=
MEETING_MAX_PARTICIPANTS=8
# ICE cho WebRTC: STUN cong khai mac dinh; TURN (coturn use-auth-secret) chi khi can, secret chi nam o backend.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Worker nhac nho ben vung (false de tat tren tien trinh nay).
REMINDER_WORKER=true
# Mui gio hien thi trong noi dung thong bao (vd gio hop). Mac dinh gio Viet Nam.
APP_TIMEZONE=Asia/Ho_Chi_Minh
REMINDER_INTERVAL_SECONDS=30
WORK_RATE_LIMIT=120
SIGNAL_RATE_LIMIT=1200

# NFR-15: noi luu tep. disk (mac dinh, nhu cu: UPLOAD_DIR) | s3 (AWS S3, MinIO...). Voi s3, UPLOAD_DIR chi la bo dem.
STORAGE_DRIVER=disk
# MinIO: http://localhost:9000 ; AWS: bo trong S3_ENDPOINT va dat S3_REGION. KHONG commit khoa that.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=chatott/
# true: duong dan dang http://host/bucket/key (MinIO). false: bucket.host (AWS virtual-hosted).
S3_FORCE_PATH_STYLE=true
# false: xoa ban cuc bo ngay sau khi day len S3.
S3_KEEP_LOCAL=true
# NFR-13: co REDIS_URL thi gioi han toc do dung chung giua cac tien trinh (dat false de tat rieng phan nay).
RATE_LIMIT_REDIS=true
